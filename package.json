{
  "name": "@lolomendez/pr-ghost",
  "version": "0.1.0",
  "description": "Automated PR video walkthrough generator",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/l-mendez/prghost.git"
  },
  "keywords": [
    "pr",
    "pull-request",
    "video",
    "walkthrough",
    "demo",
    "playwright",
    "automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "prg": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "@octokit/rest": "^21.1.0",
    "ai": "^6.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ghost-cursor-playwright": "^2.1.0",
    "ora": "^8.2.0",
    "playwright": "^1.52.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
